# Port the server listens on
PORT=3000
# Public, externally reachable base URL (tunnel/deploy). Used in OAuth metadata,
# step-up links and the QR. Leave unset for local-only (http://localhost:PORT).
PUBLIC_URL=
# EUDI reference verifier backend
EUDI_VERIFIER_URL=https://verifier-backend.eudiw.dev
# Render the QR inline in the chat via MCP Apps (set to false for link-only).
INLINE_QR=true
# Credential registry override (single-line JSON), merged onto the built-in
# defaults (pid, av, mdl, photoid). Set how each `type` the agent can request is
# obtained from YOUR wallet. Each entry: { doctype, vct?, format?, namespace?,
# claimNamespaces?, claimPaths? }.
#   - mso_mdoc  → match by `doctype`; claims are requested at [namespace, name],
#                 where namespace defaults to `doctype`. The namespace is NOT always
#                 the doctype (e.g. mDL doctype is org.iso.18013.5.1.mDL but its
#                 namespace is org.iso.18013.5.1 — already set in the mdl default).
#   - dc+sd-jwt → match by `vct` (issuer-defined; NOT the mdoc doctype). `age_over_NN`
#                 maps to ['age_equal_or_over','NN'] automatically (EUDI PID nesting).
# `claimNamespaces` overrides the namespace per claim (mso_mdoc); `claimPaths` overrides
# the full claim path (either format). The agent picks a type + claims; this maps the
# type to the wallet specifics.
#
# Shape (pretty-printed for readability — the env value must be one line):
#   {
#     "pid":      { "doctype": "eu.europa.ec.eudi.pid.1", "vct": "urn:eudi:pid:1", "format": "dc+sd-jwt" },
#     "av":       { "doctype": "eu.europa.ec.av.1", "format": "mso_mdoc" },
#     "mdl":      { "doctype": "org.iso.18013.5.1.mDL", "format": "mso_mdoc" },
#     "photoid":  { "doctype": "org.iso.23220.photoID.1", "format": "mso_mdoc" },
#     "ehic":     { "doctype": "eu.europa.ec.eudi.hiid.1", "format": "mso_mdoc" },
#     "pid_sdjwt":{ "vct": "urn:eudi:pid:1", "format": "dc+sd-jwt" }
#   }
#
# EU PID — two common shapes:
#   mso_mdoc — single namespace, doctype + namespace both `eu.europa.ec.eudi.pid.1`:
#     "pid": { "doctype": "eu.europa.ec.eudi.pid.1", "format": "mso_mdoc" }
#   dc+sd-jwt — age claims are nested under `age_equal_or_over` (e.g. age_over_18
#   maps to ['age_equal_or_over','18'] automatically):
#     "pid": { "vct": "urn:eudi:pid:1", "format": "dc+sd-jwt" }
#
# Single-line value (uncomment + adjust to your wallet):
CREDENTIAL_PROFILES={"pid":{"doctype":"eu.europa.ec.eudi.pid.1","format":"mso_mdoc"},"av":{"doctype":"eu.europa.ec.av.1","format":"mso_mdoc"}}

# Optional: persist OAuth state (client registration + tokens) to a JSON file so
# MCP clients stay connected across restarts. Defaults to an
# in-memory store (state lost on restart). Single-instance only; for multi-instance
# deployments use a shared store (Redis, Postgres, …).
# STORE_PATH=.store.json

# Registered purposes the agent can call by name. Without these the LLM has
# nothing meaningful to ask for — `request_credential` is purpose-only by
# design, so an empty registry leaves only `request_presentation` (raw DCQL).
# Built-in defaults: `age_gate`, `basic_identity`, `kyc_basic`. Override here
# to add deployment-specific purposes or rewrite the descriptions (the
# descriptions are surfaced verbatim to the LLM and shape when it fires the
# tool — make them concrete about the actions you want gated).
#
# Each entry: { claims: string[], types?: string[], description?: string }
#   - claims:      list of claim names the server requests for this purpose.
#   - types:       ordered preference list of `credentialProfiles` keys; the
#                  first that's actually configured wins.
#   - description: shown to the LLM (in the instructions block AND inside the
#                  tool description) AND used as the fallback caption above
#                  the QR when the agent didn't pass a `reason`.
#
# Shape (pretty-printed for readability — the env value must be one line):
#   {
#     "age_gate":       { "claims": ["age_over_18"], "types": ["av","pid"],
#                         "description": "Gate age-restricted content or actions (alcohol, tobacco, vapes, gambling, adult content, weapons, fireworks) or anything requiring an over-18 user." },
#     "basic_identity": { "claims": ["given_name","family_name"], "types": ["pid"],
#                         "description": "Verified first and last name. Form fill, account creation." },
#     "kyc_basic":      { "claims": ["given_name","family_name","birth_date","nationality"], "types": ["pid"],
#                         "description": "Identity at financial / employment onboarding." }
#   }
#
# Single-line value (uncomment + adjust):
# PURPOSES={"age_gate":{"claims":["age_over_18"],"types":["av","pid"],"description":"Gate age-restricted content or actions (alcohol, tobacco, vapes, gambling, adult content, weapons, fireworks)."},"basic_identity":{"claims":["given_name","family_name"],"types":["pid"],"description":"Verified first and last name. Form fill, account creation."}}

# ── Tuning knobs (all optional; each falls through to the library default when unset) ──
#
# OAuth token lifetimes (seconds). Defaults: code=300, access=3600, refresh=2592000 (30 d).
# Tighten in deployments that want smaller blast radius from a leaked token; loosen for
# long-running demos where reconnects are expensive.
# OAUTH_CODE_TTL=300
# OAUTH_ACCESS_TTL=3600
# OAUTH_REFRESH_TTL=2592000
#
# How long (seconds) a verification record stays in the store after the wallet
# completes. Long enough that `get_presentation_status` keeps answering past the
# wallet's terminal response, short enough that stale results don't accumulate.
# Default: 600 s (10 min).
# VERIFICATION_RECORD_TTL=600
#
# `get_presentation_status` long-poll tuning. Defaults: 45 s default wait,
# 55 s max (clamped), 2000 ms internal poll interval. Going above ~55 s starts
# to clash with HTTP write timeouts on common reverse proxies.
# LONG_POLL_DEFAULT_SECONDS=45
# LONG_POLL_MAX_SECONDS=55
# LONG_POLL_INTERVAL_MS=2000
